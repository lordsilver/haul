{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Haul",
  "mainBinaryName": "Haul",
  "identifier": "io.github.garysassano.haul",
  "build": {
    "frontendDist": "../haul-web/ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Multi-host download manager",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["dlc"],
        "name": "DLC container",
        "description": "JDownloader link container",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/art/header.bmp",
        "sidebarImage": "windows/art/sidebar.bmp"
      },
      "wix": {
        "bannerPath": "windows/art/banner.bmp",
        "dialogImagePath": "windows/art/dialog.bmp"
      }
    }
  }
}
